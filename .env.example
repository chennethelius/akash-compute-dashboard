# Local demonstration only. Never put credentials in git.
DEMO_MODE=true
POSTGRES_PASSWORD=compute_local_only
DATABASE_URL=postgresql+psycopg://compute:compute_local_only@localhost:5432/compute
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
AKASH_CONSOLE_URL=https://console-api.akash.network
AKASH_CHAIN_ID=akashnet-2
# Required for manual archival or the separate opt-in chain worker.
AKASH_RPC_URL=
SNAPSHOT_INTERVAL_SECONDS=600
# Choose and retain an explicit starting height; never silently skip to latest.
CHAIN_START_HEIGHT=
CHAIN_BATCH_SIZE=20
CHAIN_POLL_SECONDS=30
CHAIN_MAX_RETRY_SECONDS=300
